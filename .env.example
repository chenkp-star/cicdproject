# 以下都是公开配置，DSN 是客户端路由信息，不是上传 Token。
VITE_SENTRY_MODE=mock
VITE_SENTRY_DSN=https://00000000000000000000000000000000@sentry.invalid/1
VITE_SENTRY_ENVIRONMENT=demo
VITE_SENTRY_RELEASE=cicd-vite-demo@local
# 真实 sourcemap 上传仅在 SENTRY_UPLOAD_MODE=live 时启用。
SENTRY_UPLOAD_MODE=mock
SENTRY_ORG=demo-org
SENTRY_PROJECT=demo-project
SENTRY_AUTH_TOKEN=DEMO-NOT-A-REAL-TOKEN

